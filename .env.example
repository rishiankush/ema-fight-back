RESEND_API_KEY=
RESEND_FROM=EMA Fight Back <onboarding@resend.dev>
RESEND_TO=bs.handa@gmail.com

# Public site URL used for canonicals, sitemap, and robots.
# Set the same value on Vercel → Settings → Environment Variables (Production).
NEXT_PUBLIC_SITE_URL=https://www.emafitness.com

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Welcome popup Safety Guide leads.
# Paste the Google Apps Script web app URL from scripts/welcome-guide-sheet.gs
GUIDE_SHEET_WEBHOOK_URL=

# Optional: WhatsApp Cloud API. Without these, the team email includes the
# WhatsApp copy to send by hand from 9216-444-949. First-contact auto-send
# usually needs an approved template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Protects /api/cron/guide-follow-up (Vercel Cron sends this as Bearer).
CRON_SECRET=

# Optional. If set, the Someone Else WhatsApp/email includes the Safe Kids,
# Strong Kids activity book line with this URL.
ACTIVITY_BOOK_URL=
